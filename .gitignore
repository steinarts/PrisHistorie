# Python cache:
__pycache__/
*.py[cod]

# Virtual environments:
venv/
.venv/
env/
ENV/

# Databasefiler:
*.db

# Database backup folder:
data/

# IDE-spesifikke filer (f.eks. for VS Code, PyCharm, etc.):
.vscode/
.idea/

# Loggfiler:
*.log
logs/

# Kompilerte filer:
*.pyc

# Backup-filer:
*.bak

# Testfiler (unntatt hvis de er nødvendige for prosjektet):
test*.py

# Unntatt spesifikke kataloger (legge til eller fjerne etter behov):
DataAnalysis/
Tests/

# Operativsystem-spesifikke filer:
.DS_Store # For MacOS

# Andre filer og kataloger som ikke bør spores (legg til etter behov):
.env
secrets.yaml
backup_db.ps1

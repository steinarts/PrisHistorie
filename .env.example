# E-post varsling konfigurasjon
# Kopier denne filen til .env og fyll inn dine verdier

# Aktiver e-postvarsling
EMAIL_ALERTS_ENABLED=true

# SMTP Server (Gmail eksempel)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Avsender e-post (din e-post)
SENDER_EMAIL=din.epost@gmail.com

# App Password (IKKE vanlig passord!)
# For Gmail: https://myaccount.google.com/apppasswords
# For Outlook: https://account.live.com/proofs/AppPassword
SENDER_PASSWORD=din_app_password_her

# Mottaker e-post (hvor varsler sendes)
RECIPIENT_EMAIL=din.epost@gmail.com

# Alternativ: Outlook/Hotmail
# SMTP_SERVER=smtp-mail.outlook.com
# SMTP_PORT=587

# Kjøretøy API (Statens vegvesen)
KJORETOY_API_KEY=din_api_nokkel_her
